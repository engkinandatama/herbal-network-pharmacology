# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env/
.venv/
.venv_meeko/
*.venv*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/

# Data files (keep research data, exclude large binaries)
!data/
data/**/*.xtc
data/**/*.trr
data/**/*.edr
data/**/*.dcd
data/**/*.cpt

# Kaggle dataset temp upload folders
**/dataset_flat/
**/dataset_upload/

# Output files (regenerate from workflow)
outputs/
!outputs/.gitkeep

# Logs
logs/
*.log
!**/md-*.log
!**/md-*-mmgbsa.log
!**/mahkota-dewa-molecular-docking.log
kaggle-logs/
failed.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
.cache/
fix_*.py
_*.py

# Utility/temp scripts (prefixed with underscore)
**/_adapt_notebook.py
**/_sanitize_and_convert.py
**/_flatten_dataset.py
**/_check_dataset.py
**/_prepare_dataset.py

# API keys and secrets (if any)
.env
*.key
secrets.yaml

# Large files (Kaggle datasets - upload via kaggle API)
kaggle_dataset_upload/
kaggle_output/
*.xtc
*.trr
*.edr
*.cpt

# Simulation checkpoints
checkpoints/

# Video files
videos/

